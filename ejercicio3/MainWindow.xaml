<Window x:Class="WpfApplication1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="460" Width="525"
        Background="Brown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" TextAlignment="Center" FontSize="20" Padding="5">Calculador de Pago Mensual</TextBlock>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="20,5">
            <TextBlock Text="Horas Extras:" Foreground="White" FontSize="14"/>
            <Border Background="White" CornerRadius="12" Padding="10,0">
                <TextBox x:Name="txtHorasExtras" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="20,5">
            <TextBlock Text="Tarifa por Hora:" Foreground="White" FontSize="14"/>
            <Border Background="White" CornerRadius="12" Padding="10,0">
                <TextBox x:Name="txtTarifa" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="20,5">
            <TextBlock Text="Días de Inasistencia:" Foreground="White" FontSize="14"/>
            <Border Background="White" CornerRadius="12" Padding="10,0">
                <TextBox x:Name="txtInasistencias" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <Button x:Name="btnCalcular" Grid.Row="3" Grid.ColumnSpan="2" Content="Calcular" Click="btnCalcular_Click" HorizontalAlignment="Center" Padding="20,6"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,10">
            <TextBlock x:Name="lblHorasExtras" FontSize="16" Foreground="White" TextAlignment="Center"/>
            <TextBlock x:Name="lblBonificacion" FontSize="16" Foreground="White" TextAlignment="Center"/>
            <TextBlock x:Name="lblDescuento" FontSize="16" Foreground="White" TextAlignment="Center"/>
            <TextBlock x:Name="lblSueldoNeto" FontSize="16" Foreground="White" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>