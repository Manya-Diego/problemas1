<Window x:Class="WpfApplication1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApplication1"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="525"
        Background="Brown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" TextAlignment="Center" FontSize="20" Padding="5">Calculador de Promedio</TextBlock>

        <Border Grid.Row="1" Margin="20" Background="White" CornerRadius="12" Padding="10,0">
            <TextBox x:Name="txtNota1" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="20" Background="White" CornerRadius="12" Padding="10,0">
            <TextBox x:Name="txtNota2" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
        </Border>

        <Border Grid.Row="2" Margin="20" Background="White" CornerRadius="12" Padding="10,0">
            <TextBox x:Name="txtNota3" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Margin="20" Background="White" CornerRadius="12" Padding="10,0">
            <TextBox x:Name="txtNota4" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
        </Border>

        <Button x:Name="btnCalcular" Grid.Row="3" Grid.ColumnSpan="2" Content="Calcular" Click="btnCalcular_Click" HorizontalAlignment="Center" Padding="20,6"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,10">
            <TextBlock x:Name="lblPromedio" FontSize="16" TextAlignment="Center"/>
            <TextBlock x:Name="lblEstado" FontSize="16" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>