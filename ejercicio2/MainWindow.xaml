<Window x:Class="WpfApplication1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApplication1"
        mc:Ignorable="d"
        Title="MainWindow" Height="460" Width="525"
        Background="Brown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" TextAlignment="Center" FontSize="20" Padding="5">Generador de Correo</TextBlock>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="20,5">
            <TextBlock Text="Primer Nombre:" Foreground="White" FontSize="14"/>
            <Border Background="White" CornerRadius="12" Padding="10,0">
                <TextBox x:Name="txtNombre1" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="20,5">
            <TextBlock Text="Segundo Nombre:" Foreground="White" FontSize="14"/>
            <Border Background="White" CornerRadius="12" Padding="10,0">
                <TextBox x:Name="txtNombre2" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Margin="20,5">
            <TextBlock Text="Apellido Paterno:" Foreground="White" FontSize="14"/>
            <Border Background="White" CornerRadius="12" Padding="10,0">
                <TextBox x:Name="txtPaterno" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Margin="20,5">
            <TextBlock Text="Apellido Materno:" Foreground="White" FontSize="14"/>
            <Border Background="White" CornerRadius="12" Padding="10,0">
                <TextBox x:Name="txtMaterno" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="20,5">
            <TextBlock Text="Año de Nacimiento:" Foreground="White" FontSize="14"/>
            <Border Background="White" CornerRadius="12" Padding="10,0">
                <TextBox x:Name="txtAnio" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <Button x:Name="btnGenerar" Grid.Row="4" Grid.ColumnSpan="2" Content="Generar" Click="btnGenerar_Click" HorizontalAlignment="Center" Padding="20,6"/>

        <TextBlock x:Name="lblCorreo" Grid.Row="5" Grid.ColumnSpan="2" FontSize="16" Foreground="White" TextAlignment="Center" Margin="0,10"/>
    </Grid>
</Window>